{
  "name": "ChatsApp",
  "displayName": "ChatsApp",
  "expo": {
    "name": "ChatsApp",
    "slug": "chatsapp",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./src/assets/images/icon.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./src/assets/images/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#075E54"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.chatsapp.messenger",
      "buildNumber": "1",
      "infoPlist": {
        "NSContactsUsageDescription": "Allow ChatsApp to access your contacts to help you connect with friends",
        "NSCameraUsageDescription": "Allow ChatsApp to access your camera to send photos and videos",
        "NSMicrophoneUsageDescription": "Allow ChatsApp to access your microphone for voice messages and calls",
        "NSPhotoLibraryUsageDescription": "Allow ChatsApp to access your photo library to share photos",
        "NSPhotoLibraryAddUsageDescription": "Allow ChatsApp to save photos to your library",
        "NSLocationWhenInUseUsageDescription": "Allow ChatsApp to access your location to share with friends",
        "NSLocationAlwaysUsageDescription": "Allow ChatsApp to access your location for live location sharing",
        "NSMotionUsageDescription": "Allow ChatsApp to access motion data",
        "UIBackgroundModes": ["audio", "voip", "fetch", "remote-notification"],
        "ITSAppUsesNonExemptEncryption": false
      },
      "config": {
        "googleMapsApiKey": "YOUR_GOOGLE_MAPS_API_KEY"
      },
      "googleServicesFile": "./ios/GoogleService-Info.plist"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./src/assets/images/adaptive-icon.png",
        "backgroundColor": "#075E54"
      },
      "package": "com.chatsapp.messenger",
      "versionCode": 1,
      "permissions": [
        "CAMERA",
        "RECORD_AUDIO",
        "READ_CONTACTS",
        "WRITE_CONTACTS",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE",
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "ACCESS_BACKGROUND_LOCATION",
        "FOREGROUND_SERVICE",
        "VIBRATE",
        "RECEIVE_BOOT_COMPLETED",
        "SYSTEM_ALERT_WINDOW",
        "USE_FULL_SCREEN_INTENT"
      ],
      "googleServicesFile": "./android/app/google-services.json",
      "config": {
        "googleMaps": {
          "apiKey": "YOUR_GOOGLE_MAPS_API_KEY"
        }
      }
    },
    "plugins": [
      "@react-native-firebase/app",
      "@react-native-firebase/auth",
      "@react-native-google-signin/google-signin",
      [
        "react-native-video",
        {
          "enableNotificationControls": true,
          "enableBackgroundAudio": true
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "your-project-id"
      }
    }
  }
}
