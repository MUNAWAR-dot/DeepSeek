{
  "name": "chatsapp",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "android": "react-native run-android",
    "ios": "react-native run-ios",
    "start": "react-native start",
    "web": "expo start --web",
    "build-web": "expo export -p web",
    "test": "jest",
    "lint": "eslint . --ext .js,.jsx,.ts,.tsx",
    "format": "prettier --write .",
    "clean": "cd android && ./gradlew clean && cd ..",
    "pod-install": "cd ios && pod install && cd ..",
    "build-android": "cd android && ./gradlew assembleRelease && cd ..",
    "build-ios": "cd ios && xcodebuild -workspace ChatsApp.xcworkspace -scheme ChatsApp -configuration Release -archivePath ChatsApp.xcarchive archive && cd ..",
    "server": "cd server && npm start",
    "server-dev": "cd server && npm run dev"
  },
  "dependencies": {
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "react-native": "0.72.7",
    "react-native-web": "~0.19.0",
    "@expo/webpack-config": "^19.0.0",
    // ... rest of your dependencies remain the same ...
    "zustand": "^4.4.7"
  },
  "devDependencies": {
    // ... your dev dependencies remain the same ...
  },
  "engines": {
    "node": ">=18"
  }
}
