// src/services/deepLinkService.js
import { Linking, Platform } from 'react-native';
import { navigationRef } from '../App';

class DeepLinkService {
  constructor() {
    this.pendingDeepLink = null;
    this.listeners = [];
  }

  initialize() {
    // Handle deep links when app is already open
    this.linkingListener = Linking.addEventListener('url', this.handleDeepLink);

    // Handle deep links when app is closed
    Linking.getInitialURL()
      .then((url) => {
        if (url) {
          setTimeout(() => {
            this.handleDeepLink({ url });
          }, 1000);
        }
      })
      .catch(console.error);
  }

  handleDeepLink = ({ url }) => {
    if (!url) return;

    try {
      const parsed = this.parseDeepLink(url);
      
      if (!parsed) {
        console.warn('Unknown deep link format:', url);
        return;
      }

      // Store if navigation isn't ready
      if (!navigationRef.isReady()) {
        this.pendingDeepLink = parsed;
        return;
      }

      this.navigateToScreen(parsed);
    } catch (error) {
      console.error('Deep link handling failed:', error);
    }
  };

  parseDeepLink(url) {
    // Handle custom scheme: chatsapp://chat/123
    if (url.startsWith('chatsapp://')) {
      const path = url.replace('chatsapp://', '');
      const parts = path.split('/');
      
      switch (parts[0]) {
        case 'chat':
          return { screen: 'ChatRoom', params: { chatId: parts[1] } };
        case 'call':
          return { screen: 'VoiceCall', params: { userId: parts[1] } };
        case 'status':
          return { screen: 'StatusView', params: { userId: parts[1] } };
        case 'profile':
          return { screen: 'Profile', params: { userId: parts[1] } };
        default:
          return null;
      }
    }

    // Handle universal links: https://chatsapp.com/chat/123
    if (url.includes('chatsapp.com')) {
      const urlObj = new URL(url);
      const pathParts = urlObj.pathname.split('/').filter(Boolean);

      switch (pathParts[0]) {
        case 'chat':
          return { screen: 'ChatRoom', params: { chatId: pathParts[1] } };
        case 'group':
          return { screen: 'GroupInfo', params: { chatId: pathParts[1] } };
        case 'invite':
          return { screen: 'Register', params: { inviteCode: pathParts[1] } };
        default:
          return null;
      }
    }

    return null;
  }

  navigateToScreen({ screen, params }) {
    if (!navigationRef.isReady()) return;

    switch (screen) {
      case 'ChatRoom':
        navigationRef.navigate('Main', {
          screen: 'Tabs',
          params: {
            screen: 'Chats',
          },
        });
        setTimeout(() => {
          navigationRef.navigate('ChatRoom', params);
        }, 500);
        break;
      case 'VoiceCall':
        navigationRef.navigate('VoiceCall', params);
        break;
      case 'StatusView':
        navigationRef.navigate('StatusView', params);
        break;
      case 'Profile':
        navigationRef.navigate('Profile', params);
        break;
      default:
        break;
    }
  }

  // Generate share links
  generateShareLink(type, id) {
    const baseUrl = 'https://chatsapp.com';
    
    switch (type) {
      case 'chat':
        return `${baseUrl}/chat/${id}`;
      case 'group':
        return `${baseUrl}/group/${id}`;
      case 'invite':
        return `${baseUrl}/invite/${id}`;
      default:
        return baseUrl;
    }
  }

  // Handle pending deep links
  processPendingDeepLink() {
    if (this.pendingDeepLink && navigationRef.isReady()) {
      this.navigateToScreen(this.pendingDeepLink);
      this.pendingDeepLink = null;
    }
  }

  destroy() {
    if (this.linkingListener) {
      this.linkingListener.remove();
    }
  }
}

export default new DeepLinkService();
